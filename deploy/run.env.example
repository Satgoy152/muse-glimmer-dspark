# EnvironmentFile for both systemd units. Copy to /mnt/data/runs/run.env.
#
# This is the only file the node held that is not reproducible from the repo:
# everything else there (weights, conversations.jsonl, the specd image, the
# prepared datasets) regenerates from a documented command.
#
# Values below are the 1xH200 pair verified on the bring-up node. The
# server-and-trainer split for a multi-GPU node is in the second block.

# --- 1x H200 (verified: endpoint healthy, 37,850-token KV cache, 1.16x) ---
SEQ_LENGTH=32768
TP=1
NPROC=1
GPU_MEM_UTIL=0.92
MAX_NUM_SEQS=8

# 49,152 does NOT fit on one card: 80.45 GiB of KV cache needed against 56.69
# available, engine reports 34,639 as the ceiling. It needs weights sharded
# across GPUs to free cache -- see the 8x block.

# --- 8x H200: server on 0-3, trainer on 4-7 (VERIFIED) ---
# The two must not share a card -- pass `--gpus '"device=0,1,2,3"'` to the
# server and `--gpus '"device=4,5,6,7"'` to the trainer. On one card the server
# took ~61 GB and the trainer ~57 GB, and 139.8 GB was not enough for both.
#
# BLOCK_SIZE must be 256 at any TP > 1: 2 KV heads means 1 per rank, which
# halves the attention page to 65,536 B, below the 79,872 B hidden-state page,
# and the engine asserts. 128 is only correct at TP=1.
#
# MAX_NUM_SEQS must be >= nproc x num_workers (4 x 8 = 32 here), which is the
# number of in-flight hidden-state requests the trainer generates.
# SEQ_LENGTH=49152
# TP=4
# NPROC=4
# GPU_MEM_UTIL=0.92
# MAX_NUM_SEQS=32
# BLOCK_SIZE=256
#
# Measured at TP=4: 63,908 tokens of KV cache (1.95x concurrency at 32,768,
# 1.30x at 49,152; 65,536 will not start), ~34,000 prefill tok/s, ~2.0 rows/s.

PREP_WORKERS=8
MAX_SAMPLES=50000
SHARDS=32

DATA_ROOT=/mnt/data
HF_HOME=/mnt/data/hf
SPECULATORS_DIR=/opt/speculators
HIDDEN_STATES_PATH=/dev/shm/hidden_states
RENDER_ENDPOINT=http://127.0.0.1:8000
REPO=/mnt/data/src/muse-glimmer-dspark
RUNS=/mnt/data/runs
