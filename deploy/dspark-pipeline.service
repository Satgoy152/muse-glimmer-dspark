[Unit]
Description=DSpark speculator training pipeline (resumable)
After=vllm-extract.service
Wants=vllm-extract.service
RequiresMountsFor=/mnt/data

[Service]
Type=simple
User=sagoyal
WorkingDirectory=/mnt/data/src/muse-glimmer-dspark
# Same reason as vllm-extract: --env-file, never systemd Environment= with a
# pass-through -e, because sudo resets the environment in between.
ExecStartPre=-/usr/bin/sudo /usr/bin/docker rm -f dspark-train
ExecStart=/usr/bin/sudo /usr/bin/docker run --rm --name dspark-train \
  --gpus all --network host --ipc host \
  -v /mnt/data:/mnt/data -v /dev/shm:/dev/shm \
  --env-file /mnt/data/runs/run.env \
  specd:latest bash /mnt/data/src/muse-glimmer-dspark/scripts/pipeline.sh
ExecStop=/usr/bin/sudo /usr/bin/docker stop -t 60 dspark-train
# Every stage is marker-guarded and training resumes from its checkpoint, so a
# restart continues rather than repeats. RestartSec covers the case where the
# endpoint is still reloading after a shared preemption.
Restart=always
RestartSec=60
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
